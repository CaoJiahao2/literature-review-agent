# LLM provider (any OpenAI-compatible endpoint: OpenAI, DeepSeek, Qwen, OpenRouter, ...)
# REQUIRED — the ReAct agent has no deterministic fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Agent loop controls
# MAX_AGENT_STEPS: max LLM/tool steps before the run is aborted (default 12).
# MAX_REFLECTIONS: max rounds for each of the two self-reflection steps (search
# coverage review and report-draft review), default 1.
MAX_AGENT_STEPS=12
MAX_REFLECTIONS=1

# Cross-run memory (optional)
# MEMORY_DIR: where one JSON snapshot per normalized topic is stored.
# RESUME_MEMORY: when true, load prior sections/papers for the topic on startup.
MEMORY_DIR=~/.lit_review/memory
RESUME_MEMORY=false

# Source limits (per query, per source)
ARXIV_MAX_PER_QUERY=15
OPENALEX_MAX_PER_QUERY=15
HUGGINGFACE_MAX_PER_QUERY=20
SEMANTIC_SCHOLAR_MAX_PER_QUERY=10
CROSSREF_MAX_PER_QUERY=10

# HuggingFace trending-papers lookback window (each day = one HTTP request)
HUGGINGFACE_LOOKBACK_DAYS=7

# Which sources to enable by default (comma-separated)
# Available: arxiv, openalex, huggingface, semantic_scholar, crossref
DEFAULT_SOURCES=arxiv,openalex,huggingface

# Semantic Scholar API key (optional; raises rate limit). Get one free:
# https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=

# HTTP
REQUEST_TIMEOUT=30
USER_AGENT=LiteratureReviewAgent/0.2 (mailto:agent@example.com)
